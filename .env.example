# Environment variables for START project

# Perplexity API key (required for live research)
PERPLEXITY_API_KEY=

# OpenRouter API key (required for live content generation)
OPENROUTER_API_KEY=

# Optional: OpenAI API key if used elsewhere
OPENAI_API_KEY=

# Optional model overrides.
# IMPORTANT: leave these commented out unless you need a specific model —
# an empty value (e.g. `PERPLEXITY_MODEL=`) is treated as set and breaks the
# client. When unset, the built-in defaults are used:
#   PERPLEXITY_MODEL: llama-3.1-sonar-small-128k-online
#   OPENROUTER_MODEL: anthropic/claude-3.5-sonnet
# To override, uncomment and set a real model name:
# PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENAI_MODEL=gpt-4o-mini
